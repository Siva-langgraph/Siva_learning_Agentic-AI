# Copy to .env in this folder (webapp/backend). Never commit .env.
# Every line is optional for a local run — the backend starts without a .env at all.

# ── Supervisor ──
# Leave unset: the backend reads agent/supervisor/deployment.json, which
# `python deploy.py` in agent/supervisor writes for YOUR AWS account.
# SUPERVISOR_ARN=arn:aws:bedrock-agentcore:us-east-1:<your-account>:runtime/ecom_supervisor-XXXXXXXXXX
AWS_REGION=us-east-1

# ── Store: a real DynamoDB table, created on first start if missing (on-demand, cents) ──
APP_STORE=dynamodb
APP_TABLE=ecom-webapp

# ── Sign-in cookie key ──
# Unset: a random key — sign-ins last until the backend restarts (your data stays in DynamoDB).
# Set it to any long random string to stay signed in across restarts. On AWS: SESSION_SECRET_ID instead.
# SESSION_SECRET=
COOKIE_SECURE=false

# ── Admin console (AgentOps) ──
# Who sees /admin. Unset or * = every user (the default). A list = only those users.
# ADMIN_USERS=prudhvi,anil
# USD per 1M tokens. Leave unset until you know gpt-6-sol's price — costs then show "—".
# MODEL_PRICES={"gpt-6-sol": {"input": 0.00, "output": 0.00}}
# Knowledge base browser: Pinecone key (and OpenAI for "search by meaning") — or the *_SECRET_ID variables
# PINECONE_API_KEY=
# OPENAI_API_KEY=
